# --- Server ---
PORT=4000
LOG_LEVEL=info                     # debug logs every GraphQL request with cost and cache stats
NODE_ENV=development               # production: requires JWT_SECRET, hides stack traces, no introspection
# TRUST_PROXY=1                    # behind a reverse proxy, so rate limits use the client IP
# CORS_ORIGINS=http://localhost:5173   # only needed for a UI served from another origin

# --- Data stores ---
# npm run dev: leave these unset (or "memory") to run a local mongod and mini-redis.
# MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager
# REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=tm:

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me
JWT_TTL=12h
BCRYPT_ROUNDS=10

# --- Cache ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=120              # also bounds staleness if an invalidation is ever lost
USER_CACHE_TTL_SECONDS=600

# --- Query limits and rate limiting ---
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COST=2000              # roughly "objects a query may return"
RATE_LIMIT_POINTS=20000            # query-cost points per client per window; 0 disables
RATE_LIMIT_WINDOW_SECONDS=60
# GRAPHQL_INTROSPECTION=true       # default: on outside production
BATCH_INSERT=enabled
PING_SERVICE=enabled